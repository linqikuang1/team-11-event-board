<% if (typeof pageError !== "undefined" && pageError) { %>
  <div class="mb-3 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
    <%= pageError %>
  </div>
<% } %>

<% if (!events || events.length === 0) { %>
  <p class="text-slate-500 text-sm py-2">No matching upcoming events.</p>
<% } else { %>
  <ul class="space-y-4">
    <% events.forEach((event) => { %>
      <li class="border border-slate-200 rounded-xl bg-white shadow-sm overflow-hidden">
        
        <%# Status color band %>
        <div class="h-1 w-full
          <%= event.status === 'published' ? 'bg-green-400' :
              event.status === 'draft' ? 'bg-yellow-400' :
              event.status === 'cancelled' ? 'bg-red-400' :
              'bg-slate-300' %>">
        </div>

        <div class="p-4">
          <div class="flex items-start justify-between gap-3">
            <div>
              <a href="/events/<%= event.id %>" class="text-lg font-semibold text-blue-700 hover:underline">
                <%= event.title %>
              </a>
              <div class="flex flex-wrap items-center gap-2 mt-1.5">
                <span class="inline-flex items-center gap-1 text-sm text-slate-500">
                  📍 <%= event.location %>
                </span>
                <span class="text-slate-300">·</span>
                <span class="inline-flex items-center gap-1 text-sm text-slate-500">
                  🕐 <%= new Date(event.startTime).toLocaleString() %>
                </span>
              </div>
              <% if (event.tags && event.tags.length > 0) { %>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  <% event.tags.forEach(tag => { %>
                    <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-xs font-medium rounded-full border border-blue-100"><%= tag %></span>
                  <% }) %>
                </div>
              <% } %>
            </div>

            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium flex-shrink-0
              <%= event.status === 'published' ? 'bg-green-100 text-green-700' :
                  event.status === 'draft' ? 'bg-yellow-100 text-yellow-800' :
                  event.status === 'cancelled' ? 'bg-red-100 text-red-700' :
                  'bg-slate-100 text-slate-600' %>">
              <span class="w-1.5 h-1.5 rounded-full
                <%= event.status === 'published' ? 'bg-green-500' :
                    event.status === 'draft' ? 'bg-yellow-500' :
                    event.status === 'cancelled' ? 'bg-red-500' :
                    'bg-slate-400' %>">
              </span>
              <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
            </span>
          </div>

          <% if (typeof session !== 'undefined' && (session.authenticatedUser?.role === "staff" || session.authenticatedUser?.role === "admin")) { %>
            <div class="flex gap-2 mt-3 pt-3 border-t border-slate-100">
              
              <a  href="/events/<%= event.id %>/edit"
                class="px-3 py-1.5 text-sm rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 font-medium"
              >✏️ Edit</a>

              <form method="post" action="/events/<%= event.id %>/cancel">
                <button
                  type="submit"
                  class="px-3 py-1.5 text-sm rounded-lg bg-yellow-100 text-yellow-800 hover:bg-yellow-200 font-medium"
                >Cancel</button>
              </form>

              <form
                method="post"
                action="/events/<%= event.id %>/delete"
                hx-post="/events/<%= event.id %>/delete"
                hx-confirm="Are you sure you want to permanently delete this event?"
              >
                <button
                  type="submit"
                  class="px-3 py-1.5 text-sm rounded-lg bg-red-100 text-red-700 hover:bg-red-200 font-medium"
                >🗑️ Delete</button>
              </form>
            </div>
          <% } %>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>