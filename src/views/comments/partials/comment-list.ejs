<h2 class="text-lg sm:text-xl font-semibold tracking-tight text-slate-900 mb-1 flex flex-wrap items-baseline gap-2">
  Discussion
  <span class="text-sm font-normal text-slate-400 tabular-nums">
    · <%= comments.length %> <%= comments.length === 1 ? "comment" : "comments" %>
  </span>
</h2>
<p class="text-xs text-slate-500 mb-4 sm:mb-5">Oldest first · replies appear at the bottom.</p>

<% if (comments.length === 0) { %>
  <div
    class="rounded-2xl border border-dashed border-slate-200 bg-gradient-to-b from-slate-50/90 to-white px-4 py-10 sm:py-12 text-center"
  >
    <p class="text-slate-500 text-sm max-w-sm mx-auto leading-relaxed">
      No comments yet. Be the first to start the thread.
    </p>
  </div>
<% } else { %>
  <ul class="m-0 flex list-none flex-col gap-3 p-0 sm:gap-4" role="list">
    <% comments.forEach(function(comment) { %>
      <li
        data-comment-item
        class="comment-thread-card group relative flex gap-3 rounded-2xl border border-slate-200/90 bg-white p-3 shadow-sm ring-1 ring-slate-900/5 transition-[box-shadow,border-color] hover:border-slate-300 hover:shadow-md sm:gap-4 sm:p-4"
      >
        <div
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 text-[10px] font-bold uppercase tracking-wide text-white shadow-inner sm:h-10 sm:w-10 sm:text-xs"
          aria-hidden="true"
        >
          <%= comment.userId.slice(0, 2) %>
        </div>
        <div class="min-w-0 flex-1">
          <div class="mb-1.5 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
            <span class="text-sm font-semibold text-slate-800">
              User <%= comment.userId.slice(0, 8) %>
            </span>
            <span class="hidden text-xs text-slate-300 sm:inline" aria-hidden="true">·</span>
            <time
              class="text-xs font-medium text-slate-500 tabular-nums"
              x-data='relativeTimeslot(<%= JSON.stringify(comment.createdAt) %>)'
              x-bind:datetime="iso"
              x-text="label"
            ></time>
          </div>
          <p class="break-words text-sm leading-relaxed text-slate-700 whitespace-pre-wrap sm:text-[15px]">
            <%= comment.content %>
          </p>
          <% if (
            comment.userId === currentUserId ||
            session.authenticatedUser.role === "admin"
          ) { %>
            <form
              hx-post="/events/<%= eventId %>/comments/<%= comment.id %>/delete"
              hx-target="#comment-list"
              hx-swap="innerHTML"
              class="mt-3 border-t border-slate-100 pt-3 sm:mt-4 sm:pt-3"
            >
              <button
                type="submit"
                class="cursor-pointer rounded-lg px-2 py-1 text-xs font-semibold text-red-600 transition-colors hover:bg-red-50 hover:text-red-700"
              >
                Delete
              </button>
            </form>
          <% } %>
        </div>
      </li>
    <% }); %>
  </ul>
<% } %>
