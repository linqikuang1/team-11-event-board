<% if (entries.length === 0) { %>
  <div class="rounded-2xl border border-dashed border-slate-200 bg-gradient-to-b from-slate-50/90 to-white px-4 py-10 sm:py-12 text-center">
    <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100 text-slate-600" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="h-5 w-5">
        <path d="M7 3h10a2 2 0 0 1 2 2v16l-7-4-7 4V5a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      </svg>
    </div>
    <p class="text-slate-600 text-sm max-w-sm mx-auto leading-relaxed">
      You haven't saved any events yet. Use <span class="font-semibold">Save for Later</span> on an event to build your shortlist.
    </p>
    <div class="mt-4">
      <a href="/events" class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
        Browse Events
      </a>
    </div>
  </div>
<% } else { %>
  <div class="grid gap-4 sm:gap-5">
    <% entries.forEach(function(entry) { %>
      <div class="group p-4 border border-slate-200 rounded-2xl bg-white shadow-sm ring-1 ring-slate-900/5 flex items-start justify-between gap-4 transition hover:border-slate-300 hover:shadow-md">
        <div class="min-w-0">
          <a href="/events/<%= entry.event.id %>" class="text-base sm:text-lg font-semibold text-slate-900 group-hover:text-blue-700">
            <%= entry.event.title %>
          </a>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1.5 text-sm text-slate-500">
            <span class="inline-flex items-center gap-1.5"><span aria-hidden="true">📍</span><span><%= entry.event.location %></span></span>
            <span class="hidden text-slate-300 sm:inline" aria-hidden="true">·</span>
            <span class="inline-flex items-center gap-1.5 tabular-nums"><span aria-hidden="true">🕐</span><span><%= new Date(entry.event.startTime).toLocaleString() %></span></span>
            <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium
              <%= entry.event.status === 'published' ? 'bg-green-100 text-green-700' :
                  entry.event.status === 'draft' ? 'bg-yellow-100 text-yellow-700' :
                  entry.event.status === 'cancelled' ? 'bg-red-100 text-red-700' :
                  'bg-slate-100 text-slate-600' %>">
              <%= entry.event.status.charAt(0).toUpperCase() + entry.event.status.slice(1) %>
            </span>
          </div>
          <p class="text-xs text-slate-400 mt-2 tabular-nums">
            Saved on <%= new Date(entry.savedEvent.savedAt).toLocaleString() %>
          </p>
        </div>

        <form
          hx-post="/events/<%= entry.event.id %>/save"
          hx-target="#saved-list"
          hx-swap="innerHTML"
          method="post"
          class="flex-shrink-0"
        >
          <button
            type="submit"
            class="group inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 hover:border-slate-400"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-amber-600" aria-hidden="true">
              <path d="M7 3h10a2 2 0 0 1 2 2v16l-7-4-7 4V5a2 2 0 0 1 2-2z" fill="currentColor" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
            <span>Unsave</span>
          </button>
        </form>
      </div>
    <% }); %>
  </div>
<% } %>

