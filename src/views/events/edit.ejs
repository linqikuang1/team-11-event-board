<section class="mb-5 border border-slate-200 rounded-2xl shadow-lg overflow-hidden">
  <div class="h-1.5 w-full bg-blue-500"></div>
  <div class="p-6 bg-gradient-to-b from-white to-slate-50">
    <h1 class="text-3xl font-bold text-slate-900 mb-3">✏️ Edit Event</h1>
    <p class="text-slate-500">
      Update the details below. Changes will be saved immediately.
    </p>
  </div>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<section class="max-w-3xl p-4 sm:p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
  <div class="mb-5">
    <h2 class="text-xl font-semibold mb-1">Event Details</h2>
    <p class="text-slate-500 text-sm">
      All fields marked as required must be filled in before submitting.
    </p>
  </div>

  <form class="grid gap-4" method="post" action="/events/<%= event.id %>/edit">

    <%# Title %>
    <div class="grid gap-1.5">
      <label for="title" class="text-sm font-medium">
        📌 Title <span class="text-red-500">*</span>
      </label>
      <input
        id="title"
        name="title"
        type="text"
        required
        maxlength="200"
        value="<%= event.title %>"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      />
    </div>

    <%# Description with Alpine.js character counter %>
    <div
      class="grid gap-1.5"
      x-data="{ count: <%= event.description ? event.description.length : 0 %>, max: 5000 }"
    >
      <div class="flex items-center justify-between">
        <label for="description" class="text-sm font-medium">
          📝 Description
        </label>
        <span
          class="text-xs font-medium tabular-nums"
          :class="count >= max ? 'text-red-500' : count >= max * 0.9 ? 'text-yellow-500' : 'text-slate-400'"
          x-text="count + ' / ' + max"
        ></span>
      </div>
      <textarea
        id="description"
        name="description"
        rows="4"
        maxlength="5000"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500 resize-none"
        @input="count = $el.value.length"
      ><%= event.description %></textarea>
      <p
        x-show="count >= max * 0.9"
        x-transition
        class="text-xs text-yellow-600"
        x-text="count >= max ? 'Character limit reached.' : 'Approaching character limit.'"
      ></p>
    </div>

    <%# Location %>
    <div class="grid gap-1.5">
      <label for="location" class="text-sm font-medium">
        📍 Location <span class="text-red-500">*</span>
      </label>
      <input
        id="location"
        name="location"
        type="text"
        required
        maxlength="300"
        value="<%= event.location %>"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      />
    </div>

    <%# Start and End Time — stacked on mobile, side by side on desktop %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="grid gap-1.5">
        <label for="startTime" class="text-sm font-medium">
          🕐 Start Time <span class="text-red-500">*</span>
        </label>
        <input
          id="startTime"
          name="startTime"
          type="datetime-local"
          required
          value="<%= event.startTime.slice(0, 16) %>"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
        />
      </div>

      <div class="grid gap-1.5">
        <label for="endTime" class="text-sm font-medium">
          🏁 End Time <span class="text-red-500">*</span>
        </label>
        <input
          id="endTime"
          name="endTime"
          type="datetime-local"
          required
          value="<%= event.endTime.slice(0, 16) %>"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
        />
      </div>
    </div>

    <%# Capacity and Tags — stacked on mobile, side by side on desktop %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="grid gap-1.5">
        <label for="capacity" class="text-sm font-medium">
          🧑‍🤝‍🧑 Capacity <span class="text-slate-400 font-normal">(optional)</span>
        </label>
        <input
          id="capacity"
          name="capacity"
          type="number"
          min="1"
          value="<%= event.capacity ?? '' %>"
          placeholder="Leave blank for unlimited"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
        />
      </div>

      <div class="grid gap-1.5">
        <label for="tags" class="text-sm font-medium">
          🏷️ Tags <span class="text-slate-400 font-normal">(optional)</span>
        </label>
        <input
          id="tags"
          name="tags"
          type="text"
          value="<%= event.tags.join(', ') %>"
          placeholder="e.g. technology, networking, free"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
        />
        <p class="text-xs text-slate-400">Comma-separated</p>
      </div>
    </div>

    <%# Submit buttons %>
    <div class="flex flex-col sm:flex-row gap-3 mt-2 pt-4 border-t border-slate-100">
      <button
        type="submit"
        class="w-full sm:w-auto px-6 py-2.5 rounded-lg bg-blue-600 text-white font-medium cursor-pointer hover:bg-blue-700 text-center"
      >
        💾 Save Changes
      </button>
      <a
        href="/events/<%= event.id %>"
        class="w-full sm:w-auto px-6 py-2.5 rounded-lg border border-slate-300 text-slate-600 font-medium hover:bg-slate-50 text-center"
      >
        Cancel
      </a>
    </div>

  </form>
</section>