<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <div class="flex items-center justify-between gap-4 mb-3">
    <h1 class="text-3xl font-bold text-slate-900">Upcoming Events</h1>
    <% if (session.authenticatedUser?.role === "staff" || session.authenticatedUser?.role === "admin") { %>
      <a href="/events/create" class="px-4 py-2.5 rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700">Create Event</a>
    <% } %>
  </div>
  <form
    method="get"
    action="/events"
    hx-get="/events/search"
    hx-target="#event-list"
    hx-swap="innerHTML"
    hx-trigger="change, submit, keyup changed delay:400ms from:input[name='q']"
    hx-push-url="true"
  >
    <div class="grid gap-3 md:grid-cols-3">
      <input
        type="search"
        name="q"
        value="<%= q %>"
        placeholder="Search by title, description, or location"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      />

      <select
        name="category"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      >
        <option value="">All categories</option>
        <% availableCategories.forEach((item) => { %>
          <option value="<%= item %>" <%= item === category ? "selected" : "" %>><%= item %></option>
        <% }) %>
      </select>

      <select
        name="timeframe"
        class="w-full px-3 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500"
      >
        <option value="all" <%= timeframe === "all" ? "selected" : "" %>>All upcoming</option>
        <option value="week" <%= timeframe === "week" ? "selected" : "" %>>This week</option>
        <option value="weekend" <%= timeframe === "weekend" ? "selected" : "" %>>This weekend</option>
      </select>
    </div>
    <button
      type="submit"
      class="mt-3 px-4 py-2.5 rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700"
    >
      Apply Filters
    </button>
  </form>
</section>

<% if (typeof successMessage !== 'undefined' && successMessage) { %>
  <div class="mb-4 p-4 border border-green-200 rounded-2xl bg-green-50 text-green-700 text-sm font-medium">
    <%= successMessage %>
  </div>
<% } %>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<% if (typeof myDrafts !== 'undefined' && myDrafts.length > 0) { %>
  <section class="mb-5 p-6 border border-yellow-200 rounded-2xl bg-yellow-50 shadow-lg">
    <h2 class="text-xl font-bold text-yellow-800 mb-4">My Drafts</h2>
    <ul class="space-y-3">
      <% myDrafts.forEach((draft) => { %>
        <li class="p-4 border border-yellow-200 rounded-xl bg-white shadow-sm flex items-center justify-between">
          <div>
            <a href="/events/<%= draft.id %>" class="text-lg font-semibold text-blue-700 hover:underline">
              <%= draft.title %>
            </a><br />
            <span class="text-sm text-slate-500"><%= draft.location %></span><br />
            <span class="text-sm text-slate-500"><%= draft.startTime %></span>
          </div>
          <form method="post" action="/events/<%= draft.id %>/publish">
            <button
              type="submit"
              class="px-4 py-2 text-sm rounded-lg bg-blue-600 text-white hover:bg-blue-700 font-medium"
            >Publish</button>
          </form>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<section class="max-w-3xl p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
  <div id="event-list">
    <%- include("../partials/list", { events: events, session: session }) %>
  </div>
</section>