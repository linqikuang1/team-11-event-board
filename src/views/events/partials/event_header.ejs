<%
  const user = session.authenticatedUser;
%>
<section id="event-header" class="mb-5 border border-slate-200 rounded-2xl shadow-lg overflow-hidden">

  <div class="h-2 w-full
    <%= event.status === 'published' ? 'bg-green-500' :
        event.status === 'draft' ? 'bg-yellow-400' :
        event.status === 'cancelled' ? 'bg-red-500' :
        'bg-slate-400' %>">
  </div>

  <div class="p-4 sm:p-6 bg-gradient-to-b from-white to-slate-50">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
      <div>
        <a href="/events" class="text-sm text-slate-400 hover:text-slate-600 mb-3 inline-flex items-center gap-1">
          ← Back to Events
        </a>
        <h1 class="text-3xl font-bold text-slate-900 mb-3"><%= event.title %></h1>
        <div class="flex flex-wrap items-center gap-2">
          <span
            id="status-badge"
            x-data="{ visible: false }"
            x-show="visible"
            x-transition:enter="transition-all duration-300"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-init="$nextTick(() => visible = true)"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium
              <%= event.status === 'published' ? 'bg-green-100 text-green-700' :
                  event.status === 'draft' ? 'bg-yellow-100 text-yellow-800' :
                  event.status === 'cancelled' ? 'bg-red-100 text-red-700' :
                  'bg-slate-100 text-slate-600' %>"
          >
            <span class="w-1.5 h-1.5 rounded-full
              <%= event.status === 'published' ? 'bg-green-500' :
                  event.status === 'draft' ? 'bg-yellow-500' :
                  event.status === 'cancelled' ? 'bg-red-500' :
                  'bg-slate-400' %>">
            </span>
            <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
          </span>
          <% if (event.tags && event.tags.length > 0) { %>
            <% event.tags.forEach(tag => { %>
              <span class="px-2.5 py-1 bg-blue-50 text-blue-600 text-xs font-medium rounded-full border border-blue-100"><%= tag %></span>
            <% }) %>
          <% } %>
        </div>
      </div>

      <% if (user?.role === "staff" || user?.role === "admin") { %>
        <div
          class="flex flex-col gap-2 flex-shrink-0"
          x-data="{ attendeesOpen: false, attendeesLoaded: false }"
        >
          <div id="event-controls" class="flex gap-2 flex-wrap">
            <button
              type="button"
              class="px-4 py-2 rounded-lg border border-slate-300 text-slate-600 text-sm font-medium hover:bg-slate-50"
              :aria-expanded="attendeesOpen.toString()"
              aria-controls="attendee-list-inline"
              @click="
                attendeesOpen = !attendeesOpen;
                if (attendeesOpen && !attendeesLoaded) {
                  htmx.ajax('GET', '/events/<%= event.id %>/attendees', '#attendee-list-inline');
                  attendeesLoaded = true;
                }
              "
            >
              <span x-show="!attendeesOpen">👥 View Attendees</span>
              <span x-show="attendeesOpen">🙈 Hide Attendees</span>
            </button>
            <% if (event.status === "draft" || event.status === "published") { %>
              <a href="/events/<%= event.id %>/edit" class="px-4 py-2 rounded-lg border border-slate-300 text-slate-600 text-sm font-medium hover:bg-slate-50">✏️ Edit</a>
            <% } %>
            <% if (event.status === "draft") { %>
              <button
                class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 cursor-pointer"
                hx-post="/events/<%= event.id %>/publish"
                hx-target="#event-header"
                hx-swap="outerHTML"
                hx-disabled-elt="this"
              >🚀 Publish</button>
            <% } %>
            <% if (event.status === "published") { %>
              <button
                class="px-4 py-2 rounded-lg bg-red-600 text-white text-sm font-medium hover:bg-red-700 cursor-pointer"
                hx-post="/events/<%= event.id %>/cancel"
                hx-target="#event-header"
                hx-swap="outerHTML"
                hx-disabled-elt="this"
              >Cancel Event</button>
            <% } %>
          </div>
          <section
            id="attendee-list-inline"
            class="mt-5 basis-full max-w-3xl"
            x-show="attendeesOpen"
            x-transition.opacity.duration.200ms
          ></section>
        </div>
      <% } %>
    </div>
  </div>
</section>