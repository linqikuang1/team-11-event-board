<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <div class="flex items-start justify-between gap-4">
    <div>
      <a href="/events/<%= event.id %>" class="text-sm text-slate-500 hover:text-slate-700 mb-2 inline-block">← Back to Event</a>
      <h1 class="text-3xl font-bold text-slate-900 mb-2">Attendee List</h1>
      <p class="text-slate-700"><%= event.title %></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
          Attending: <%= attendeeGroups.attending.length %>
        </span>
        <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
          Waitlisted: <%= attendeeGroups.waitlisted.length %>
        </span>
        <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-rose-100 text-rose-800">
          Cancelled: <%= attendeeGroups.cancelled.length %>
        </span>
      </div>
    </div>
  </div>
</section>

<%- include("partials/attendee-list", { attendeeGroups: attendeeGroups }) %>
