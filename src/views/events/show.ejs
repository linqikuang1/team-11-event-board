<%# ── Header banner ─────────────────────────────────────────── %>
<section class="mb-5 border border-slate-200 rounded-2xl shadow-lg overflow-hidden">
  
  <%# Color band at top based on status %>
  <div class="h-2 w-full
    <%= event.status === 'published' ? 'bg-green-500' :
        event.status === 'draft' ? 'bg-yellow-400' :
        event.status === 'cancelled' ? 'bg-red-500' :
        'bg-slate-400' %>">
  </div>

  <div class="p-4 sm:p-6 bg-gradient-to-b from-white to-slate-50">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
      <div>
        <a href="/events" class="text-sm text-slate-400 hover:text-slate-600 mb-3 inline-flex items-center gap-1">
          ← Back to Events
        </a>
        <h1 class="text-3xl font-bold text-slate-900 mb-3"><%= event.title %></h1>
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium
            <%= event.status === 'published' ? 'bg-green-100 text-green-700' :
                event.status === 'draft' ? 'bg-yellow-100 text-yellow-800' :
                event.status === 'cancelled' ? 'bg-red-100 text-red-700' :
                'bg-slate-100 text-slate-600' %>">
            <span class="w-1.5 h-1.5 rounded-full
              <%= event.status === 'published' ? 'bg-green-500' :
                  event.status === 'draft' ? 'bg-yellow-500' :
                  event.status === 'cancelled' ? 'bg-red-500' :
                  'bg-slate-400' %>">
            </span>
            <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
          </span>
          <% if (event.tags && event.tags.length > 0) { %>
            <% event.tags.forEach(tag => { %>
              <span class="px-2.5 py-1 bg-blue-50 text-blue-600 text-xs font-medium rounded-full border border-blue-100"><%= tag %></span>
            <% }) %>
          <% } %>
        </div>
      </div>

      <% if (session.authenticatedUser?.role === "staff" || session.authenticatedUser?.role === "admin") { %>
        <div class="flex gap-2 flex-shrink-0 flex-wrap">
          <button
            type="button"
            hx-get="/events/<%= event.id %>/attendees"
            hx-target="#attendee-list-inline"
            hx-swap="innerHTML"
            class="px-4 py-2 rounded-lg border border-slate-300 text-slate-600 text-sm font-medium hover:bg-slate-50"
          >
            👥 Attendees
          </button>
          <% if (event.status === "draft" || event.status === "published") { %>
            <a href="/events/<%= event.id %>/edit" class="px-4 py-2 rounded-lg border border-slate-300 text-slate-600 text-sm font-medium hover:bg-slate-50">✏️ Edit</a>
          <% } %>
          <% if (event.status === "draft") { %>
            <form method="post" action="/events/<%= event.id %>/publish">
              <button type="submit" class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700">
                🚀 Publish
              </button>
            </form>
          <% } %>
          <% if (event.status === "published") { %>
            <form method="post" action="/events/<%= event.id %>/cancel">
              <button type="submit" class="px-4 py-2 rounded-lg bg-red-600 text-white text-sm font-medium hover:bg-red-700">
                Cancel Event
              </button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</section>

<%# ── Event details ──────────────────────────────────────────── %>
<section class="max-w-3xl p-4 sm:p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
  <div class="grid gap-6">

    <% if (event.description) { %>
      <div>
        <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">About</h2>
        <p class="text-slate-700 leading-relaxed"><%= event.description %></p>
      </div>
      <hr class="border-slate-100" />
    <% } %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="flex gap-3 items-start">
        <span class="text-xl mt-0.5">📍</span>
        <div>
          <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Location</h2>
          <p class="text-slate-800 font-medium"><%= event.location %></p>
        </div>
      </div>

      <%# Start Time with Alpine.js relative label %>
      <div
        class="flex gap-3 items-start"
        x-data="{
          relativeTime: '',
          init() {
            const diff = Math.round((new Date('<%= event.startTime %>') - new Date()) / 86400000);
            if (diff === 0) this.relativeTime = 'today';
            else if (diff === 1) this.relativeTime = 'tomorrow';
            else if (diff === -1) this.relativeTime = 'yesterday';
            else if (diff > 1) this.relativeTime = 'in ' + diff + ' days';
            else this.relativeTime = Math.abs(diff) + ' days ago';
          }
        }"
      >
        <span class="text-xl mt-0.5">🕐</span>
        <div>
          <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Start Time</h2>
          <p class="text-slate-800 font-medium"><%= new Date(event.startTime).toLocaleString() %></p>
          <p class="text-xs text-blue-500 font-medium mt-0.5" x-text="relativeTime"></p>
        </div>
      </div>

      <%# End Time with Alpine.js relative label %>
      <div
        class="flex gap-3 items-start"
        x-data="{
          relativeTime: '',
          init() {
            const diff = Math.round((new Date('<%= event.endTime %>') - new Date()) / 86400000);
            if (diff === 0) this.relativeTime = 'ends today';
            else if (diff === 1) this.relativeTime = 'ends tomorrow';
            else if (diff === -1) this.relativeTime = 'ended yesterday';
            else if (diff > 1) this.relativeTime = 'ends in ' + diff + ' days';
            else this.relativeTime = 'ended ' + Math.abs(diff) + ' days ago';
          }
        }"
      >
        <span class="text-xl mt-0.5">🏁</span>
        <div>
          <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">End Time</h2>
          <p class="text-slate-800 font-medium"><%= new Date(event.endTime).toLocaleString() %></p>
          <p class="text-xs text-slate-400 font-medium mt-0.5" x-text="relativeTime"></p>
        </div>
      </div>

      <div class="flex gap-3 items-start">
        <span class="text-xl mt-0.5">🧑‍🤝‍🧑</span>
        <div>
          <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Capacity</h2>
          <% if (event.capacity) { %>
            <p class="text-slate-800 font-medium"><%= attendeeCount %> / <%= event.capacity %> attending</p>
            <div class="mt-1.5 w-full bg-slate-100 rounded-full h-1.5">
              <% const fillPct = Math.min(100, Math.round((attendeeCount / event.capacity) * 100)); %>
              <div class="h-1.5 rounded-full <%= attendeeCount >= event.capacity ? 'bg-red-400' : 'bg-blue-500' %>"
                style="--w: <%= fillPct %>%; width: var(--w)">
              </div>
            </div>
          <% } else { %>
            <p class="text-slate-800 font-medium"><%= attendeeCount %> attending · Unlimited capacity</p>
          <% } %>
        </div>
      </div>
    </div>

    <% if (session.authenticatedUser?.role === "user") { %>
      <hr class="border-slate-100" />
      <div class="flex flex-wrap items-center gap-3">
        <%- include("../events/partials/rsvp_button", {
          eventId:      event.id,
          outcome:      rsvpOutcome,
          attendeeCount: attendeeCount,
          capacity:     event.capacity,
          readonly:     event.status !== "published" || new Date(event.startTime) <= new Date(),
        }) %>
        <%- include("../saved/partials/save-toggle", { eventId: event.id, isSaved: (typeof isSaved === "boolean" ? isSaved : false) }) %>
      </div>
    <% } %>

  </div>
</section>

<% if (session.authenticatedUser?.role === "staff" || session.authenticatedUser?.role === "admin") { %>
  <section id="attendee-list-inline" class="mt-5 max-w-3xl"></section>
<% } %>

<%# ── Comments ───────────────────────────────────────────────── %>
<section class="mt-5 max-w-3xl p-4 sm:p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-xl font-semibold text-slate-900">💬 Comments</h2>
    <a href="/events/<%= event.id %>/comments" class="text-sm text-blue-600 hover:text-blue-800 font-medium">View All →</a>
  </div>
  <p class="text-slate-500 text-sm">Join the discussion about this event.</p>
</section>