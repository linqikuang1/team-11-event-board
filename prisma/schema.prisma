generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Event {
  id          String   @id
  title       String
  description String
  location    String
  startTime   String
  endTime     String
  status      String   @default("draft")
  organizerId String
  createdAt   String
  updatedAt   String
  capacity    Int?
  tags        String   @default("[]")

  rsvps Rsvp[]
}

model Rsvp {
  eventId   String
  userId    String
  status    String
  createdAt String
  updatedAt String

  event Event @relation(fields: [eventId], references: [id])

  @@id([eventId, userId])
}