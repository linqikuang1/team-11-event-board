generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Comment {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([userId, createdAt])
}
