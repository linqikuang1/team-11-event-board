generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Event {
  id          String   @id
  title       String
  description String
  location    String
  startTime   String
  endTime     String
  status      String   @default("draft")
  organizerId String
  createdAt   String
  updatedAt   String
  capacity    Int?
  tags        String   @default("[]")

  rsvps Rsvp[]
}

model Rsvp {
  eventId   String
  userId    String
  status    String
  createdAt String
  updatedAt String

  event Event @relation(fields: [eventId], references: [id])

  @@id([eventId, userId])
}
model Comment {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([userId, createdAt])
}

model SavedEvent {
  id      String   @id @default(uuid())
  eventId String
  userId  String
  savedAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId, savedAt])
  @@index([eventId])
}
